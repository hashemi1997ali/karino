# Application
NODE_ENV=development
PORT=4000

# The bundled Next.js client is one trusted proxy hop away.
TRUST_PROXY_HOPS=1

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/task-manager-api

# JWT
ACCESS_JWT_SECRET=replace_with_a_long_random_access_secret
REFRESH_JWT_SECRET=replace_with_a_long_random_refresh_secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
JWT_ISSUER=task-manager-api

# Authentication rate limits (per IP; window values are milliseconds)
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW_MS=3600000
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_MS=900000
AUTH_REFRESH_RATE_LIMIT=30
AUTH_REFRESH_RATE_WINDOW_MS=900000
AUTH_REFRESH_SESSION_RATE_LIMIT=30
AUTH_REFRESH_SESSION_RATE_WINDOW_MS=900000

# Optional Cloudinary attachment upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bootstrap an existing account as the only initial super admin
SUPER_ADMIN_EMAIL=

# AI assistant provider: openrouter, openai, anthropic, gemini, ollama, or none
AI_PROVIDER=openrouter
AI_TIMEOUT_MS=25000
AI_APP_NAME=Karino Task Manager
APP_URL=http://localhost:3000

# AI provider credentials and models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Chat retention and abuse protection
SUPPORT_CHAT_RETENTION_DAYS=90
CHAT_GUEST_RATE_LIMIT=20
CHAT_GUEST_RATE_WINDOW_MS=900000
CHAT_AUTH_RATE_LIMIT=80
CHAT_AUTH_RATE_WINDOW_MS=900000
CHAT_SUGGESTION_RATE_LIMIT=30
CHAT_SUGGESTION_RATE_WINDOW_MS=900000
